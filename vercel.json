{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/api",
      "destination": "/api/index.py"
    },
    {
      "source": "/chat",
      "destination": "/api/index.py"
    },
    {
      "source": "/models",
      "destination": "/api/index.py"
    },
    {
      "source": "/cloud/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/memory/(.*)",
      "destination": "/api/index.py"
    }
  ]
}
